# Segredos de servidor. Runtime via Supavisor; migrations via conexão direta.
# APP_MODE=showcase publica somente a interface, sem exigir os valores abaixo.
DATABASE_URL="postgresql://postgres.PROJECT_REF:DB_PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres:DB_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"

# Configurações públicas do provedor; usadas somente pelo servidor nesta entrega.
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="SUPABASE_PUBLISHABLE_KEY"

# Segredo reservado para administração de convites, não usado no login.
SUPABASE_SERVICE_ROLE_KEY="SUPABASE_SERVICE_ROLE_KEY"

# Opcionais até configurar o projeto Sentry.
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
